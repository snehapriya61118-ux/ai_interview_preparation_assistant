# Application Secrets
SECRET_KEY=ai_interview_coach_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite for dev, PostgreSQL ready)
DATABASE_URL=sqlite:///./ai_interview_coach.db
# Example PostgreSQL: postgresql://user:password@localhost:5432/ai_interview_coach

# AI & Speech APIs (Leave empty to automatically trigger standalone DEMO_MODE)
LLM_API_KEY=
LLM_PROVIDER=openai
# Options: openai, gemini, anthropic, custom
LLM_MODEL=gpt-4o-mini

SPEECH_TO_TEXT_API_KEY=
